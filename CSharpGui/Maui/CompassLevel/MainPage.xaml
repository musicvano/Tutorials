<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CompassLevel.MainPage"
             Title="Compass and Level">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label x:Name="headingLabel" FontSize="32"
               HorizontalOptions="Center" />
        <Label x:Name="needle" Text="▲" FontSize="64"
               HorizontalOptions="Center" />
        <Border WidthRequest="200" HeightRequest="200"
                StrokeShape="Ellipse" StrokeThickness="2"
                HorizontalOptions="Center">
            <Ellipse x:Name="bubble" WidthRequest="24"
                     HeightRequest="24" Fill="Gray"
                     HorizontalOptions="Center"
                     VerticalOptions="Center" />
        </Border>
        <Label x:Name="tiltLabel" FontSize="18"
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
