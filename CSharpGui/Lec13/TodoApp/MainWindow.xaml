<Window x:Class="TodoApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="clr-namespace:TodoApp.Core;assembly=TodoApp.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=core:TodoViewModel}"
    Title="To-Do List" Width="360" Height="320">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="_Add"
                    IsDefault="True" Padding="10,2" Margin="6,0,0,0"
                    Command="{Binding AddCommand}"/>
            <TextBox Text="{Binding NewTitle,
                     UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="_Save"
                    Padding="10,2" Command="{Binding SaveCommand}"/>
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Items.Count,
                       StringFormat=Tasks: {0}}"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding Items}" Margin="0,6,0,0"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type core:TodoItem}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                            Content="Remove"
                            CommandParameter="{Binding}"
                            Command="{Binding
                                DataContext.RemoveCommand,
                                RelativeSource={RelativeSource
                                AncestorType=ListBox}}"/>
                        <CheckBox IsChecked="{Binding IsDone}"
                                  Content="{Binding Title}"
                                  VerticalAlignment="Center"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
